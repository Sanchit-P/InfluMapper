        isBotRing: false,
        recommended: true,
        fitScore: '93 / 100'
      },
      {
        id: 'scuderiaferrarif1.bsky.social',
        handle: 'scuderiaferrarif1.bsky.social (Scuderia Ferrari)',
        displayName: 'Scuderia Ferrari F1',
        avatar: 'https://cdn.bsky.app/img/avatar/plain/did:plc:la4tfg6j2beizqywjwslpom4/bafkreibpayl6emrcuethfzavsb4zbgtgxxftyer62m4srzbffg5kn6lonq',
        platform: 'Bluesky (AT Protocol)',
        community: 'Formula 1 Racing Network',
        pageRank: '0.0755',
        cascadeReach: '1.45M+ Reach',
        cascadeDepth: '5 Tiers',
        botRisk: '0.3% (Verified Tifosi Hub)',
