<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Audience Graph & Ambassador Reach</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- React 18 & ReactDOM via CDN -->
  <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
  <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
  
  <!-- Babel for JSX -->
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  
  <!-- Cytoscape.js for high-speed graph visualization -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cytoscape/3.28.1/cytoscape.min.js"></script>

  <style>
    :root {
      --bg-dark: #07090e;
      --card-bg: rgba(13, 18, 30, 0.92);
      --border-color: rgba(255, 255, 255, 0.08);
      --accent-cyan: #00f2fe;
      --accent-blue: #38bdf8;
      --accent-gold: #f59e0b;
      --accent-green: #10b981;
      --accent-red: #ef4444;
      --accent-purple: #8b5cf6;
      --text-main: #f8fafc;
      --text-dim: #94a3b8;
      --font-ui: 'Outfit', sans-serif;
      --font-code: 'JetBrains Mono', monospace;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      font-family: var(--font-ui);
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow: hidden;
      user-select: none;
    }

    #root {
      display: flex;
      flex-direction: column;
      height: 100vh;
      width: 100vw;
    }

    /* Top Navigation */
    header {
      background: rgba(10, 14, 24, 0.96);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border-color);
      padding: 12px 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 10;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 14px;
      font-weight: 800;
      font-size: 1.22rem;
      letter-spacing: 0.5px;
    }

    .brand-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      box-shadow: 0 0 20px rgba(0, 242, 254, 0.4);
    }

    .campaign-selector {
      display: flex;
      align-items: center;
      gap: 12px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border-color);
      padding: 6px 16px;
      border-radius: 24px;
    }

    .campaign-label {
      font-size: 0.76rem;
      color: var(--text-dim);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      font-weight: 600;
    }

    select.niche-dropdown {
      background: transparent;
      border: none;
      color: var(--accent-cyan);
      font-family: var(--font-ui);
      font-weight: 700;
      font-size: 0.92rem;
      outline: none;
      cursor: pointer;
    }

    select.niche-dropdown option {
      background: #0d121e;
      color: #fff;
    }

    .badge-status {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: var(--accent-green);
      font-size: 0.75rem;
      font-weight: 700;
      padding: 5px 12px;
      border-radius: 20px;
      text-transform: uppercase;
    }

    .badge-status.offline {
      background: rgba(239, 68, 68, 0.12);
      border-color: rgba(239, 68, 68, 0.3);
      color: var(--accent-red);
    }

    .pulse-dot {
      width: 7px;
      height: 7px;
      background-color: var(--accent-green);
      border-radius: 50%;
      animation: pulse 1.6s infinite;
    }

    .badge-status.offline .pulse-dot {
      background-color: var(--accent-red);
      animation: none;
      box-shadow: none;
    }

    @keyframes pulse {
      0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
      70% { transform: scale(1.15); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
      100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    /* Main Workspace */
    main {
      display: flex;
      flex: 1;
      overflow: hidden;
      position: relative;
    }

    #canvas-container {
      flex: 6.8;
      position: relative;
      background: radial-gradient(circle at 40% 40%, #0d1322 0%, #06080e 100%);
      border-right: 1px solid var(--border-color);
      overflow: hidden;
    }

    #cy {
      width: 100%;
      height: 100%;
      position: absolute;
      top: 0;
      left: 0;
    }

    .canvas-hud-bar {
      position: absolute;
      bottom: 24px;
      left: 24px;
      display: flex;
      gap: 12px;
      z-index: 5;
    }

    button.btn-action {
      background: rgba(16, 22, 36, 0.9);
      backdrop-filter: blur(12px);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      padding: 10px 18px;
      border-radius: 10px;
      font-family: var(--font-ui);
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
    }

    button.btn-action:hover {
      background: rgba(0, 242, 254, 0.16);
      border-color: var(--accent-cyan);
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(0, 242, 254, 0.25);
    }

    button.btn-action.btn-primary {
      background: linear-gradient(135deg, rgba(0, 242, 254, 0.2), rgba(37, 99, 235, 0.3));
      border-color: var(--accent-cyan);
      color: #fff;
    }

    /* Right Ambassador Sidebar */
    aside {
      flex: 3.2;
      min-width: 420px;
      max-width: 480px;
      background: var(--card-bg);
      backdrop-filter: blur(24px);
      display: flex;
      flex-direction: column;
      overflow-y: auto;
      padding: 24px;
      gap: 20px;
    }

    .panel-card {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 16px;
    }

    .panel-title {
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--text-dim);
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-weight: 700;
    }

    /* Ambassador Candidate Cards */
    .candidate-card {
      background: rgba(0, 0, 0, 0.35);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 14px;
      margin-bottom: 12px;
      cursor: pointer;
      transition: all 0.2s ease;
      position: relative;
    }

    .candidate-card:hover {
      border-color: var(--accent-cyan);
      background: rgba(0, 242, 254, 0.05);
      transform: translateY(-2px);
    }

    .candidate-card.selected {
      border-color: var(--accent-cyan);
      background: rgba(0, 242, 254, 0.09);
      box-shadow: 0 0 18px rgba(0, 242, 254, 0.15);
    }

    .candidate-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
    }

    .candidate-handle {
      font-family: var(--font-code);
      font-weight: 700;
      font-size: 0.95rem;
      color: #fff;
    }

    .delete-btn {
      background: transparent;
      border: none;
      color: var(--text-dim);
      font-size: 0.9rem;
      cursor: pointer;
      padding: 2px 6px;
      border-radius: 4px;
      transition: color 0.15s;
    }

    .delete-btn:hover {
      color: var(--accent-red);
      background: rgba(239, 68, 68, 0.1);
    }

    .rank-badge {
      font-size: 0.72rem;
      font-weight: 800;
      padding: 3px 8px;
      border-radius: 6px;
      background: rgba(245, 158, 11, 0.18);
      color: var(--accent-gold);
      border: 1px solid rgba(245, 158, 11, 0.35);
    }

    .stats-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-top: 10px;
    }

    .stat-pill {
      background: rgba(255, 255, 255, 0.04);
      padding: 8px 10px;
      border-radius: 8px;
      text-align: center;
    }

    .stat-val {
      font-family: var(--font-code);
      font-size: 0.98rem;
      font-weight: 700;
      color: var(--accent-cyan);
    }

    .stat-lbl {
      font-size: 0.65rem;
      text-transform: uppercase;
      color: var(--text-dim);
      margin-top: 2px;
    }

    .fraud-clean {
      color: var(--accent-green);
    }

    .fraud-warning {
      color: var(--accent-red);
    }

    /* Campaign Projected ROI Box */
    .roi-box {
      background: linear-gradient(135deg, rgba(0, 242, 254, 0.08), rgba(139, 92, 246, 0.08));
      border: 1px solid rgba(0, 242, 254, 0.25);
      border-radius: 12px;
      padding: 16px;
    }

    .roi-val {
      font-size: 1.6rem;
      font-family: var(--font-code);
      font-weight: 800;
      color: var(--accent-cyan);
    }

    /* Brand Ambassador Scout Panel */
    .scout-panel {
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.08), rgba(0, 242, 254, 0.05));
      border: 1px solid rgba(139, 92, 246, 0.25);
      border-radius: 14px;
      padding: 18px;
    }

    .scout-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
    }

    .scout-icon {
      font-size: 1.4rem;
    }

    .scout-title {
      font-size: 0.88rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: var(--accent-purple);
    }

    .kol-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 12px;
      background: rgba(0, 0, 0, 0.3);
      border-radius: 8px;
      margin-bottom: 8px;
      transition: all 0.2s ease;
      cursor: pointer;
      border: 1px solid transparent;
    }

    .kol-row:hover {
      background: rgba(139, 92, 246, 0.1);
      border-color: rgba(139, 92, 246, 0.3);
      transform: translateX(4px);
    }

    .kol-info {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .kol-rank {
      font-family: var(--font-code);
      font-size: 0.85rem;
      font-weight: 800;
      color: var(--accent-gold);
      min-width: 24px;
    }

    .kol-handle {
      font-family: var(--font-code);
      font-size: 0.82rem;
      font-weight: 600;
      color: #fff;
    }

    .kol-metrics {
      display: flex;
      gap: 12px;
      align-items: center;
    }

    .kol-metric {
      text-align: right;
    }

    .kol-metric-val {
      font-family: var(--font-code);
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--accent-cyan);
    }

    .kol-metric-lbl {
      font-size: 0.6rem;
      color: var(--text-dim);
      text-transform: uppercase;
    }

    .risk-meter {
      width: 60px;
      height: 6px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 3px;
      overflow: hidden;
    }

    .risk-fill {
      height: 100%;
      border-radius: 3px;
      transition: width 0.3s ease;
    }

    .risk-low { background: linear-gradient(90deg, #10b981, #34d399); }
    .risk-medium { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
    .risk-high { background: linear-gradient(90deg, #ef4444, #f87171); }

    .risk-label {
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      margin-left: 6px;
    }
    /* Twitter stats banner */
    .twitter-stats-banner {
      position: absolute;
      top: 16px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 12px;
      z-index: 8;
      background: rgba(15, 20, 30, 0.88);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(249, 115, 22, 0.35);
      border-radius: 12px;
      padding: 10px 18px;
      align-items: center;
    }

    .tw-stat {
      display: flex;
      flex-direction: column;
      align-items: center;
      min-width: 72px;
    }

    .tw-stat-val {
      font-family: var(--font-code);
      font-size: 1.0rem;
      font-weight: 800;
      color: #f97316;
    }

    .tw-stat-lbl {
      font-size: 0.6rem;
      color: var(--text-dim);
      text-transform: uppercase;
      margin-top: 2px;
    }

    .tw-divider {
      width: 1px;
      height: 32px;
      background: rgba(249, 115, 22, 0.25);
    }

    .tw-platform-badge {
      display: flex;
      align-items: center;
      gap: 6px;
      background: rgba(249, 115, 22, 0.1);
      border: 1px solid rgba(249, 115, 22, 0.3);
      border-radius: 8px;
      padding: 4px 10px;
      font-size: 0.78rem;
      font-weight: 700;
      color: #f97316;
    }
  </style>
</head>
<body>
  <div id="root"></div>

  <!-- React 18 Application Script -->
  <script type="text/babel">
    const { useState, useEffect, useRef } = React;

    // =========================================================================
    // Backend connection helpers
    // =========================================================================
    const BACKEND_URL = 'http://localhost:18080';
    const WS_URL = 'ws://localhost:18080/ws';

    // GET a JSON endpoint; rejects on non-2xx or network failure.
    const apiGet = (path) =>
      fetch(BACKEND_URL + path).then(res => {
        if (!res.ok) throw new Error(`API ${path} failed: ${res.status}`);
        return res.json();
      });

    // Deterministic integer hash of a string (used for per-candidate theming).
    const charCodeSum = (s) => (s || 'seed').split('').reduce((acc, c) => acc + c.charCodeAt(0), 0);

    // --- Platform filtering -------------------------------------------------
    // Graph/candidate handles carry a platform prefix: ig: / th: / tw:.
    // Unprefixed handles are Bluesky (or legacy mocks).
    const handleMatchesPlatform = (handle, platform) => {
      const h = handle || '';
      if (platform === 'Instagram') return h.startsWith('ig:');
      if (platform === 'Threads')   return h.startsWith('th:');
      if (platform === 'X')         return h.startsWith('tw:');
      return !h.startsWith('ig:') && !h.startsWith('th:') && !h.startsWith('tw:');
    };
    // Candidates also carry a `platform` label; accept either signal so
    // manually-added handles still land in the right view.
    const candidateMatchesPlatform = (c, platform) => {
      if (platform === 'X') return true; // X uses its own static list
      const h = c.handle || c.id || '';
      const p = c.platform || '';
      if (platform === 'Instagram') return p.startsWith('Instagram') || h.startsWith('ig:');
      if (platform === 'Threads')   return p.startsWith('Threads')   || h.startsWith('th:');
      return p.startsWith('Bluesky') ||
             (!h.startsWith('ig:') && !h.startsWith('th:') && !h.startsWith('tw:'));
    };

    // --- Niche filtering ----------------------------------------------------
    // Backend classifies each node's niche from its handle (fashion, fitness,
    // motorsport, tech…). 'All Niches' / empty = no filter. Free-text values
    // substring-match the niche, falling back to the legacy community label.
    const candidateMatchesNiche = (c, niche) => {
      const q = (niche || '').trim().toLowerCase();
      if (!q || q === 'all niches') return true;
      const n = (c.niche || 'Other').toLowerCase();
      return n === q || n.includes(q) ||
             (c.community || '').toLowerCase().includes(q.split(' ')[0]);
    };
    const nodeMatchesNiche = (niche, selected) => {
      const q = (selected || '').trim().toLowerCase();
      if (!q || q === 'all niches') return true;
      if (niche === undefined || niche === null) return true; // legacy/mock nodes
      const n = String(niche).toLowerCase();
      return n === q || n.includes(q);
    };

    // Signature color themes for cascade waves, picked by candidate hash.
    const CASCADE_PALETTES = [
      { primary: '#00f2fe', pulse: '#38bdf8', edge: '#00f2fe' },
      { primary: '#10b981', pulse: '#34d399', edge: '#10b981' },
      { primary: '#f59e0b', pulse: '#fbbf24', edge: '#f59e0b' },
      { primary: '#8b5cf6', pulse: '#a78bfa', edge: '#8b5cf6' },
      { primary: '#ec4899', pulse: '#f472b6', edge: '#ec4899' }
    ];
    const cascadeThemeFor = (candidate) => CASCADE_PALETTES[charCodeSum(candidate && candidate.id) % CASCADE_PALETTES.length];

    // Nodes matching a candidate: by cytoscape id, then node_id, then handle
    // substring in the label. Returns an empty collection when nothing matches.
    const matchCandidateNodes = (cy, candidate) => {
      let nodes = candidate.id ? cy.$('#' + candidate.id) : cy.collection();
      if (!nodes || nodes.length === 0) {
        const clean = (candidate.handle || '').split(' ')[0].replace(/^@/, '');
        if (clean) nodes = cy.nodes().filter(n => (n.data('label') || '').includes(clean));
      }
      if ((!nodes || nodes.length === 0) && candidate.node_id !== undefined) {
        nodes = cy.nodes().filter(n => n.data('node_id') === candidate.node_id);
      }
      return nodes;
    };

    // Best-effort node for a candidate: exact match, else first influencer,
    // else first node. Always returns a collection (possibly the fallback).
    const findCandidateNode = (cy, candidate) => {
      const matched = matchCandidateNodes(cy, candidate);
      if (matched && matched.length > 0) return matched;
      const inf = cy.nodes('[type = "influencer"]').first();
      return (inf && inf.length > 0) ? inf : cy.nodes().first();
    };

    // =========================================================================
    // Static fallback data (used when the C++ backend is unreachable)
    // =========================================================================
    const INITIAL_CANDIDATES = [
      {
        id: 'cry-ptos.bsky.social',
        handle: 'cry-ptos.bsky.social (Your Live Bluesky)',
        displayName: 'cry-ptos.bsky.social',
        avatar: 'https://cdn.bsky.app/img/avatar/plain/did:plc:o3hqqc4lyy6c6l234pcsqnoa/bafkreicxpqvlj234ik5z7nngmqtj4uekum4j6nit6snzmpxazeoynv6fji',
        platform: 'Bluesky (AT Protocol)',
        community: 'Motorsport & Tech Cluster',
        pageRank: '0.0837',
        cascadeReach: 'Full-Time Live AT Stream',
        cascadeDepth: '5 Tiers',
        botRisk: '0.2% (Verified Protocol Key)',
        isBotRing: false,
        recommended: true,
        fitScore: '100 / 100'
      },
      {
        id: 'bsky.app',
        handle: 'bsky.app (Bluesky Official)',
        displayName: 'Bluesky',
        avatar: 'https://cdn.bsky.app/img/avatar/plain/did:plc:z72i7hdynmk6r22z27h6tvur/bafkreihwihm6kpd6zuwhhlro75p5qks5qtrcu55jp3gddbfjsieiv7wuka',
        platform: 'Bluesky (AT Protocol)',
        community: 'Protocol Core Hub',
        pageRank: '0.0837',
        cascadeReach: '35.2M+ Reach',
        cascadeDepth: '6 Tiers',
        botRisk: '0.1% (Core Protocol Hub)',
        isBotRing: false,
        recommended: true,
        fitScore: '99 / 100'
      },
      {
        id: 'auditeamf1.bsky.social',
        handle: 'auditeamf1.bsky.social (Audi F1)',
        displayName: 'Audi F1',
        avatar: 'https://cdn.bsky.app/img/avatar/plain/did:plc:wvr6nn5fx5isfubb47c72o4j/bafkreiayxljuohvewpgvjjnrq2vaoqouhz7nwpj5zlinutqjyrg66rejxq',
        platform: 'Bluesky (AT Protocol)',
        community: 'Formula 1 Racing Network',
        pageRank: '0.0795',
        cascadeReach: '185K+ Impressions',
        cascadeDepth: '5 Tiers',
        botRisk: '0.4% (Verified F1 Brand)',
        isBotRing: false,
        recommended: true,
        fitScore: '96 / 100'
      },
      {
        id: 'alpinef1.bsky.social',
        handle: 'alpinef1.bsky.social (BWT Alpine F1)',
        displayName: 'BWT Alpine Formula One Team',
        avatar: 'https://cdn.bsky.app/img/avatar/plain/did:plc:fyrmu3np57bfi2xlyxidjbjf/bafkreiektgsljgus2qxdag6zcmbqhd3g4onwq6ebqctn2whumxl2q5k4eu',
        platform: 'Bluesky (AT Protocol)',
        community: 'Formula 1 Racing Network',
        pageRank: '0.0786',
        cascadeReach: '290K+ Impressions',
        cascadeDepth: '4 Tiers',
        botRisk: '0.3% (Verified Official)',
        isBotRing: false,
        recommended: true,
        fitScore: '95 / 100'
      },
      {
        id: 'haasf1team.bsky.social',
        handle: 'haasf1team.bsky.social (MoneyGram Haas F1)',
        displayName: 'MoneyGram Haas F1 Team',
        avatar: 'https://cdn.bsky.app/img/avatar/plain/did:plc:6fvr32owkuqdykqa4j3hqrqn/bafkreibp2j64d4hfznxtqt6mfx2lnafkfur6a7eo2t5n6up6ca5ipohnbm',
        platform: 'Bluesky (AT Protocol)',
        community: 'Formula 1 Racing Network',
        pageRank: '0.0769',
        cascadeReach: '420K+ Impressions',
        cascadeDepth: '4 Tiers',
        botRisk: '0.2% (Official Team)',
        isBotRing: false,
        recommended: true,
        fitScore: '94 / 100'
      },
      {
        id: 'williamsracingf1.bsky.social',
        handle: 'williamsracingf1.bsky.social (Williams Racing F1)',
        displayName: 'Williams Racing F1',
        avatar: 'https://cdn.bsky.app/img/avatar/plain/did:plc:mkq3zxmekw6jufezluxqznys/bafkreifhw2sekiq5s3ufcsbmohkq7z33d3h7giggbiqfzhgyckymzj35la',
        platform: 'Bluesky (AT Protocol)',
        community: 'Formula 1 Racing Network',
        pageRank: '0.0763',
